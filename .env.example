# Gunakan sandi alfanumerik unik; URL koneksi pada Compose menginterpolasikan nilai ini.
POSTGRES_PASSWORD=opis_local_only
# Data contoh hanyalah simulasi dan diberi label. Ubah menjadi false untuk workspace kosong.
OPIS_DEMO_DATA=true
# Aktifkan hanya jika perlu memonitor alamat privat di jaringan tepercaya.
OPIS_ALLOW_PRIVATE_TARGETS=false
OPIS_CHECK_CONCURRENCY=10
